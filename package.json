{
  "name": "sleepsounds",
  "description": "White noise, rain, ocean and more, generated on your device",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeappstore-online/sleepsounds.git"
  },
  "scripts": {
    "dev": "pnpm --filter @sleepsounds/web dev",
    "build": "pnpm --filter @sleepsounds/web build",
    "preview": "pnpm --filter @sleepsounds/web preview",
    "typecheck": "pnpm --filter @sleepsounds/web exec tsc -b && tsc -p e2e",
    "test": "pnpm --filter @sleepsounds/web test",
    "e2e": "pnpm build && playwright test",
    "live-check": "node scripts/live-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "playwright": "^1.64.1",
    "typescript": "6.0.3"
  }
}
